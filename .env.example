# Published content only. Keep real tokens in .env, never in source files.
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
STORYBLOK_REGION=eu
STORYBLOK_PREVIEW_MODE=0
# Optional for local API integration tests; leave empty in normal use.
STORYBLOK_API_BASE_URL=

# Only needed once to create the Storyblok content model and import archive stories.
STORYBLOK_SPACE_ID=
STORYBLOK_MANAGEMENT_TOKEN=
